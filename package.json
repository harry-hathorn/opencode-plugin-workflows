{
	"name": "opencode-plugin-workflows",
	"version": "0.4.0",
	"description": "Deterministic multi-agent workflow orchestration for opencode — a shareable plugin. JavaScript orchestration scripts (agent/parallel/pipeline/phase/log/budget) fan out over real subagent sessions, with a journal that makes every run resumable from cache.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./tui": {
			"import": "./dist/tui.js",
			"types": "./dist/tui.d.ts"
		}
	},
	"license": "MIT",
	"author": "Harry Hathorn (https://github.com/harry-hathorn)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/harry-hathorn/opencode-plugin-workflows.git"
	},
	"bugs": {
		"url": "https://github.com/harry-hathorn/opencode-plugin-workflows/issues"
	},
	"engines": {
		"node": ">=20",
		"opencode": ">=2.0.0"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@opencode/plugin": "2.2.5"
	},
	"peerDependencies": {
		"@opentui/core": ">=0.8.0",
		"@opentui/solid": ">=0.8.0",
		"solid-js": ">=1.9.0"
	},
	"keywords": [
		"opencode-plugin",
		"opencode",
		"workflows",
		"multi-agent",
		"orchestration",
		"subagents",
		"agent",
		"ai"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src test",
		"format": "biome format --write src test",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@opencode/theme": "^2.2.5",
		"@opentui/core": "0.8.2",
		"@opentui/solid": "0.8.2",
		"@types/node": "^24.0.0",
		"acorn": "^8.15.0",
		"acorn-walk": "^8.3.0",
		"solid-js": "1.9.12",
		"tsup": "^8.5.0",
		"typescript": "^5.7.0",
		"zod": "4.1.8"
	}
}
